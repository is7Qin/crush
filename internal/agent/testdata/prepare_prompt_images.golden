[]fantasy.Message{fantasy.Message{Role:"user", Content:[]fantasy.MessagePart{fantasy.TextPart{Text:"<system_reminder>This is a reminder that your todo list is currently empty. DO NOT mention this to the user explicitly because they are already aware.\nIf you are working on tasks that would benefit from a todo list please use the \"todos\" tool to create one.\nIf not, please feel free to ignore. Again do not mention this message to the user.</system_reminder>", ProviderOptions:fantasy.ProviderOptions(nil)}}, ProviderOptions:fantasy.ProviderOptions(nil)}, fantasy.Message{Role:"user", Content:[]fantasy.MessagePart{fantasy.TextPart{Text:"hello", ProviderOptions:fantasy.ProviderOptions(nil)}}, ProviderOptions:fantasy.ProviderOptions(nil)}, fantasy.Message{Role:"assistant", Content:[]fantasy.MessagePart{fantasy.TextPart{Text:"let me check", ProviderOptions:fantasy.ProviderOptions(nil)}, fantasy.ReasoningPart{Text:"need to run two tools", ProviderOptions:fantasy.ProviderOptions{}}, fantasy.ToolCallPart{ToolCallID:"call_A", ToolName:"bash", Input:"{\"command\":\"date\"}", ProviderExecuted:false, ProviderOptions:fantasy.ProviderOptions(nil)}, fantasy.ToolCallPart{ToolCallID:"call_B", ToolName:"view", Input:"{\"path\":\"/foo\"}", ProviderExecuted:false, ProviderOptions:fantasy.ProviderOptions(nil)}}, ProviderOptions:fantasy.ProviderOptions(nil)}, fantasy.Message{Role:"tool", Content:[]fantasy.MessagePart{fantasy.ToolResultPart{ToolCallID:"call_A", Output:fantasy.ToolResultOutputContentText{Text:"Fri May 2 21:00:00 UTC 2026"}, ProviderExecuted:false, ProviderOptions:fantasy.ProviderOptions(nil), ClientMetadata:""}, fantasy.ToolResultPart{ToolCallID:"call_B", Output:fantasy.ToolResultOutputContentMedia{Data:"ZmFrZS1wbmctZGF0YQ==", MediaType:"image/png", Text:""}, ProviderExecuted:false, ProviderOptions:fantasy.ProviderOptions(nil), ClientMetadata:""}}, ProviderOptions:fantasy.ProviderOptions(nil)}, fantasy.Message{Role:"user", Content:[]fantasy.MessagePart{fantasy.TextPart{Text:"are we done?", ProviderOptions:fantasy.ProviderOptions(nil)}}, ProviderOptions:fantasy.ProviderOptions(nil)}, fantasy.Message{Role:"assistant", Content:[]fantasy.MessagePart{fantasy.ToolCallPart{ToolCallID:"call_orphaned", ToolName:"agent", Input:"{\"prompt\":\"search\"}", ProviderExecuted:false, ProviderOptions:fantasy.ProviderOptions(nil)}}, ProviderOptions:fantasy.ProviderOptions(nil)}, fantasy.Message{Role:"tool", Content:[]fantasy.MessagePart{fantasy.ToolResultPart{ToolCallID:"call_orphaned", Output:fantasy.ToolResultOutputContentError{Error:(*errors.errorString)(0xPTR)}, ProviderExecuted:false, ProviderOptions:fantasy.ProviderOptions(nil), ClientMetadata:""}}, ProviderOptions:fantasy.ProviderOptions(nil)}, fantasy.Message{Role:"user", Content:[]fantasy.MessagePart{fantasy.TextPart{Text:"see attached\n<system_info>The files below have been attached by the user, consider them in your response</system_info>\n<file path='notes.txt'>\n\nimportant notes\n</file>\n", ProviderOptions:fantasy.ProviderOptions(nil)}, fantasy.FilePart{Filename:"image.png", Data:[]uint8{0xPTR, 0xPTR, 0xPTR, 0xPTR, 0xPTR, 0xPTR, 0xPTR, 0xPTR, 0xPTR, 0xPTR, 0xPTR, 0xPTR, 0xPTR, 0xPTR, 0xPTR}, MediaType:"image/png", ProviderOptions:fantasy.ProviderOptions(nil)}}, ProviderOptions:fantasy.ProviderOptions(nil)}, fantasy.Message{Role:"assistant", Content:[]fantasy.MessagePart{fantasy.TextPart{Text:"Summary of prior work: checked the date.", ProviderOptions:fantasy.ProviderOptions(nil)}}, ProviderOptions:fantasy.ProviderOptions(nil)}, fantasy.Message{Role:"user", Content:[]fantasy.MessagePart{fantasy.TextPart{Text:"continue", ProviderOptions:fantasy.ProviderOptions(nil)}}, ProviderOptions:fantasy.ProviderOptions(nil)}}
